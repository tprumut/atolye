<?xml version="1.0" encoding="utf-8"?>
<plugin-metadata
    pluginId="com.toolbox.plugin.sessecici"
    version="1"
    minHostVersion="1"
    nameRes="@string/plugin_sessecici_name"
    descriptionRes="@string/plugin_sessecici_desc"
    iconRes="@drawable/ic_sessecici"
    settingsActivity="com.toolbox.plugin.sessecici.SesSeciciSettingsActivity"
    mainActivity="com.toolbox.plugin.sessecici.SesSeciciPluginActivity"
    commandReceiver="com.toolbox.plugin.sessecici.SesSeciciCommandReceiver"
    category="MEDIA"
    tags="ses, ses seçici, çıkış, hoparlör, kulaklık, bluetooth, usb, volume"
    accentColor="#00897B"
    downloadUrl="https://github.com/tprumut/atolye/releases/latest/download/plugin-ses-secici-debug.apk"
    minSdk="26">
    <required-permissions>
        <permission
            name="android.permission.MODIFY_AUDIO_SETTINGS"
            titleRes="@string/permission_modify_audio_title"
            descriptionRes="@string/permission_modify_audio_desc"
            isRequired="true" />
        <permission
            name="android.permission.POST_NOTIFICATIONS"
            titleRes="@string/permission_post_notifications_title"
            descriptionRes="@string/permission_post_notifications_desc"
            isRequired="false" />
        <permission
            name="android.permission.BLUETOOTH_CONNECT"
            titleRes="@string/permission_bluetooth_connect_title"
            descriptionRes="@string/permission_bluetooth_connect_desc"
            isRequired="false" />
    </required-permissions>
    <quick-settings>
        <quick-setting key="auto_apply_on_connect" titleRes="@string/auto_apply_on_connect" type="toggle" defaultValue="true" />
        <quick-setting key="notification_enabled" titleRes="@string/notification_enabled" type="toggle" defaultValue="true" />
        <quick-setting key="experimental_app_audio" titleRes="@string/app_audio_experimental" type="toggle" defaultValue="false" />
    </quick-settings>
</plugin-metadata>
