<?xml version="1.0" encoding="utf-8"?>
<plugin-metadata
    pluginId="com.toolbox.plugin.keepawake"
    version="1"
    minHostVersion="1"
    nameRes="@string/plugin_keepawake_name"
    descriptionRes="@string/plugin_keepawake_desc"
    iconRes="@drawable/ic_keepawake"
    settingsActivity="com.toolbox.plugin.keepawake.KeepAwakeSettingsActivity"
    mainActivity="com.toolbox.plugin.keepawake.KeepAwakePluginActivity"
    commandReceiver="com.toolbox.plugin.keepawake.KeepAwakeCommandReceiver"
    category="DISPLAY"
    tags="ekran, açık, tut, wake, keep, screen, uyanık"
    downloadUrl="https://github.com/tprumut/atolye/releases/latest/download/plugin-keepawake-debug.apk"
    minSdk="26">
    <required-permissions>
        <permission
            name="android.permission.SYSTEM_ALERT_WINDOW"
            titleRes="@string/permission_system_alert_window_title"
            descriptionRes="@string/permission_system_alert_window_desc"
            isRequired="true" />
        <permission
            name="android.permission.WAKE_LOCK"
            titleRes="@string/permission_wake_lock_title"
            descriptionRes="@string/permission_wake_lock_desc"
            isRequired="true" />
        <permission
            name="android.permission.PACKAGE_USAGE_STATS"
            titleRes="@string/permission_usage_stats_title"
            descriptionRes="@string/permission_usage_stats_desc"
            isRequired="false" />
        <permission
            name="android.permission.FOREGROUND_SERVICE"
            titleRes="@string/permission_foreground_service_title"
            descriptionRes="@string/permission_foreground_service_desc"
            isRequired="true" />
        <permission
            name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
            titleRes="@string/permission_foreground_service_title"
            descriptionRes="@string/permission_foreground_service_desc"
            isRequired="true" />
        <permission
            name="android.permission.POST_NOTIFICATIONS"
            titleRes="@string/permission_post_notifications_title"
            descriptionRes="@string/permission_post_notifications_desc"
            isRequired="true" />
    </required-permissions>
    <quick-settings>
        <quick-setting key="mode" titleRes="@string/qs_mode" type="choice" defaultValue="1">
            <option value="1" labelRes="@string/qs_mode_timed" />
            <option value="2" labelRes="@string/qs_mode_infinite" />
            <option value="3" labelRes="@string/qs_mode_app" />
        </quick-setting>
        <quick-setting key="timer_duration" titleRes="@string/qs_duration" type="choice" defaultValue="15">
            <option value="15" labelRes="@string/keepawake_timer_15min" />
            <option value="30" labelRes="@string/keepawake_timer_30min" />
            <option value="60" labelRes="@string/keepawake_timer_1hour" />
            <option value="120" labelRes="@string/keepawake_timer_2hour" />
        </quick-setting>
        <quick-setting key="show_notification" titleRes="@string/qs_notification" type="toggle" defaultValue="true" />
    </quick-settings>
</plugin-metadata>