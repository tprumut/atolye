<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/plugin_keepawake_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeepAwake"
        tools:targetApi="31">

        <!-- Main Plugin Activity -->
        <activity
            android:name=".KeepAwakePluginActivity"
            android:exported="true"
            android:label="@string/plugin_keepawake_name"
            android:theme="@style/Theme.KeepAwake"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.toolbox.PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.toolbox.plugin.METADATA"
                android:resource="@xml/plugin_metadata" />
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".KeepAwakeSettingsActivity"
            android:exported="true"
            android:label="@string/keepawake_settings_title"
            android:theme="@style/Theme.KeepAwake"
            android:parentActivityName=".KeepAwakePluginActivity" />

        <!-- Overlay Service -->
        <service
            android:name=".KeepAwakeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the screen on while selected apps are in the foreground" />
        </service>

        <!-- Quick Settings Tile -->
        <service
            android:name=".KeepAwakeTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/ic_qs_screen_off"
            android:label="@string/plugin_keepawake_short">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

    <queries>
        <package android:name="com.atolye.host" />
        <package android:name="com.atolye.host.debug" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>