<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- İzinler host uygulamasının manifestine birleştirilir -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".KeepAwakePluginActivity"
            android:exported="false"
            android:label="@string/plugin_keepawake_name"
            android:theme="@style/Theme.KeepAwake"
            android:launchMode="singleTop" />

        <activity
            android:name=".KeepAwakeSettingsActivity"
            android:exported="false"
            android:label="@string/keepawake_settings_title"
            android:theme="@style/Theme.KeepAwake"
            android:parentActivityName=".KeepAwakePluginActivity" />

        <service
            android:name=".KeepAwakeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the screen on while selected apps are in the foreground" />
        </service>

        <service
            android:name=".KeepAwakeTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/ic_qs_screen_off"
            android:label="@string/plugin_keepawake_short">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".KeepAwakeCommandReceiver"
            android:exported="false"
            android:permission="com.toolbox.permission.CONTROL_PLUGIN">
            <intent-filter>
                <action android:name="com.toolbox.PLUGIN_COMMAND" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Uygulama bazlı mod için launcher uygulamalarını sorgulayabilmek gerekir -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
