<?xml version="1.0" encoding="utf-8"?>
<!--
  JetBrains Mono Variable Font
  Download from: https://github.com/JetBrains/JetBrainsMono/releases
  Place JetBrainsMono[opsz,wght].ttf in this directory and reference it here.
  This XML file allows using the variable font as a FontFamily.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="100"
        app:fontWeight="100" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="200"
        app:fontWeight="200" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:fontWeight="300" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:fontWeight="400" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:fontWeight="500" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:fontWeight="600" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:fontWeight="700" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:fontWeight="800" />
    <font
        android:font="@font/jetbrains_mono_variable_ttf"
        android:fontStyle="normal"
        android:fontWeight="900"
        app:fontWeight="900" />
</font-family>