<?xml version="1.0" encoding="utf-8"?>
<plugin-metadata
    pluginId="com.toolbox.plugin.speedmeter"
    version="1"
    minHostVersion="1"
    nameRes="@string/plugin_speedmeter_name"
    descriptionRes="@string/plugin_speedmeter_desc"
    iconRes="@drawable/ic_speedmeter"
    settingsActivity="com.toolbox.plugin.speedmeter.SpeedMeterSettingsActivity"
    mainActivity="com.toolbox.plugin.speedmeter.SpeedMeterPluginActivity"
    commandReceiver="com.toolbox.plugin.speedmeter.SpeedMeterCommandReceiver"
    category="NETWORK"
    tags="internet, hız, veri, kullanım, traffic"
    downloadUrl="https://github.com/tprumut/atolye/releases/latest/download/plugin-speedmeter-debug.apk"
    minSdk="26">
    <required-permissions>
        <permission
            name="android.permission.FOREGROUND_SERVICE"
            titleRes="@string/permission_foreground_service_title"
            descriptionRes="@string/permission_foreground_service_desc"
            isRequired="true" />
        <permission
            name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
            titleRes="@string/permission_foreground_data_sync_title"
            descriptionRes="@string/permission_foreground_data_sync_desc"
            isRequired="true" />
        <permission
            name="android.permission.INTERNET"
            titleRes="@string/permission_network_title"
            descriptionRes="@string/permission_network_desc"
            isRequired="false" />
        <permission
            name="android.permission.RECEIVE_BOOT_COMPLETED"
            titleRes="@string/permission_receive_boot_title"
            descriptionRes="@string/permission_receive_boot_desc"
            isRequired="true" />
        <permission
            name="android.permission.POST_NOTIFICATIONS"
            titleRes="@string/permission_post_notifications_title"
            descriptionRes="@string/permission_post_notifications_desc"
            isRequired="true" />
    </required-permissions>
    <quick-settings>
        <quick-setting key="network_mode" titleRes="@string/speedmeter_network_mode" type="choice" defaultValue="0">
            <option value="0" labelRes="@string/speedmeter_network_mode_total" />
            <option value="1" labelRes="@string/speedmeter_network_mode_wifi" />
            <option value="2" labelRes="@string/speedmeter_network_mode_mobile" />
        </quick-setting>
        <quick-setting key="unit" titleRes="@string/speedmeter_unit" type="choice" defaultValue="0">
            <option value="0" labelRes="@string/speedmeter_unit_auto" />
            <option value="1" labelRes="@string/speedmeter_unit_kbps" />
            <option value="2" labelRes="@string/speedmeter_unit_mbps" />
        </quick-setting>
        <quick-setting key="autostart" titleRes="@string/speedmeter_autostart" type="toggle" defaultValue="true" />
    </quick-settings>
</plugin-metadata>