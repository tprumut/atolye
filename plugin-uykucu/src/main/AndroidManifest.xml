<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- İzinler host uygulamasının manifestine birleştirilir -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <activity
            android:name=".UykucuPluginActivity"
            android:exported="false"
            android:label="@string/plugin_uykucu_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Uykucu" />

        <activity
            android:name=".UykucuSettingsActivity"
            android:exported="false"
            android:label="@string/uykucu_settings_title"
            android:parentActivityName=".UykucuPluginActivity"
            android:theme="@style/Theme.Uykucu" />

        <service
            android:name=".UykucuTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sleep timer countdown and device lock automation" />
        </service>

        <service
            android:name=".UykucuAccessibilityService"
            android:exported="false"
            android:label="@string/plugin_uykucu_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".UykucuAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".UykucuCommandReceiver"
            android:exported="false"
            android:permission="com.toolbox.permission.CONTROL_PLUGIN">
            <intent-filter>
                <action android:name="com.toolbox.PLUGIN_COMMAND" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
