<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Host control channel -->
    <permission
        android:name="com.toolbox.permission.CONTROL_PLUGIN"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.toolbox.permission.CONTROL_PLUGIN" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/plugin_uykucu_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uykucu"
        tools:targetApi="34">

        <activity
            android:name=".UykucuPluginActivity"
            android:exported="true"
            android:label="@string/plugin_uykucu_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Uykucu">
            <intent-filter>
                <action android:name="com.toolbox.PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.toolbox.plugin.METADATA"
                android:resource="@xml/plugin_metadata" />
        </activity>

        <activity
            android:name=".UykucuSettingsActivity"
            android:exported="true"
            android:label="@string/uykucu_settings_title"
            android:parentActivityName=".UykucuPluginActivity"
            android:theme="@style/Theme.Uykucu" />

        <service
            android:name=".UykucuTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sleep timer countdown and device lock automation" />
        </service>

        <service
            android:name=".UykucuAccessibilityService"
            android:exported="false"
            android:label="@string/plugin_uykucu_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".UykucuAlarmReceiver"
            android:exported="false" />

        <!-- Host command receiver -->
        <receiver
            android:name=".UykucuCommandReceiver"
            android:exported="true"
            android:permission="com.toolbox.permission.CONTROL_PLUGIN">
            <intent-filter>
                <action android:name="com.toolbox.PLUGIN_COMMAND" />
            </intent-filter>
        </receiver>

    </application>

    <queries>
        <package android:name="com.atolye.host" />
        <package android:name="com.atolye.host.debug" />
    </queries>

</manifest>
