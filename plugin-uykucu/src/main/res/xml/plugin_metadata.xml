<?xml version="1.0" encoding="utf-8"?>
<plugin-metadata
    pluginId="com.toolbox.plugin.uykucu"
    version="1"
    minHostVersion="1"
    nameRes="@string/plugin_uykucu_name"
    descriptionRes="@string/plugin_uykucu_desc"
    iconRes="@drawable/ic_uykucu"
    settingsActivity="com.toolbox.plugin.uykucu.UykucuSettingsActivity"
    mainActivity="com.toolbox.plugin.uykucu.UykucuPluginActivity"
    commandReceiver="com.toolbox.plugin.uykucu.UykucuCommandReceiver"
    category="TOOLS"
    tags="uyku, zamanlayıcı, uyku zamanlayıcısı, sleep, timer, kilit"
    accentColor="#5C6BC0"
    downloadUrl="https://github.com/tprumut/atolye/releases/latest/download/plugin-uykucu-debug.apk"
    minSdk="26">
    <required-permissions>
        <permission
            name="android.permission.BIND_ACCESSIBILITY_SERVICE"
            titleRes="@string/permission_accessibility_title"
            descriptionRes="@string/permission_accessibility_desc"
            isRequired="true" />
        <permission
            name="android.permission.FOREGROUND_SERVICE"
            titleRes="@string/permission_foreground_service_title"
            descriptionRes="@string/permission_foreground_service_desc"
            isRequired="true" />
        <permission
            name="android.permission.POST_NOTIFICATIONS"
            titleRes="@string/permission_post_notifications_title"
            descriptionRes="@string/permission_post_notifications_desc"
            isRequired="true" />
        <permission
            name="android.permission.SCHEDULE_EXACT_ALARM"
            titleRes="@string/permission_exact_alarm_title"
            descriptionRes="@string/permission_exact_alarm_desc"
            isRequired="true" />
    </required-permissions>
    <quick-settings>
        <quick-setting key="stop_media_enabled" titleRes="@string/uykucu_stop_media" type="toggle" defaultValue="true" />
        <quick-setting key="close_apps_enabled" titleRes="@string/uykucu_close_apps" type="toggle" defaultValue="true" />
        <quick-setting key="remember_last_duration" titleRes="@string/uykucu_remember_last" type="toggle" defaultValue="true" />
    </quick-settings>
</plugin-metadata>
